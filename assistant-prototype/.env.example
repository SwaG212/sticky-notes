# 小智桌面助手原型环境变量示例
# 复制本文件为 .env 并填入真实值，.env 不要提交仓库

# DeepSeek API Key（必填，阶段 1 文字闭环需要）
DEEPSEEK_API_KEY=

# DeepSeek API 地址与模型（可选，默认值如下）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 对话相关（可选）
# 追问后连续对话窗口秒数，默认 15
FOLLOW_UP_WINDOW_MS=15000
# 单轮录音最长毫秒数，默认 60000（阶段 2 使用）
MAX_RECORDING_MS=60000
# 说话结束静音判定毫秒数，默认 1350（阶段 2 使用）
SILENCE_END_MS=1350
